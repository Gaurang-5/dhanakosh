# Copy to .env.docker, or run ./scripts/prepare-docker-env.sh
# .env.docker holds this computer's master key and password hash. Do not commit it.
#
# The password hash is an Argon2id string. In this file, double every $:
#   WF_AUTH_PASSWORD_HASH=$$argon2id$$v=19$$...
# Generate both values with ./scripts/prepare-docker-env.sh

WF_LISTEN_ADDR=0.0.0.0:8088
WF_DB_PATH=/data/wealthfolio.db
WF_SECRET_KEY=
WF_AUTH_PASSWORD_HASH=
WF_CORS_ALLOW_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
WF_REQUEST_TIMEOUT_MS=30000
WF_STATIC_DIR=dist
